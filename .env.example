# Copy this file to .env (or .keys.env) and fill in any keys you have.
# Keys are optional for Offline mode or explicitly enabled anonymous OVH access.
# One key is enough; add more and the pool fails over between them automatically.

GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
SAMBANOVA_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
DEEPINFRA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-sonnet-4-6
# GitHub Models retired on July 30, 2026; its old token is no longer used.

# Optional: override the models tried for a provider (comma separated)
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional: any OpenAI-compatible endpoint, tried first
# STEALTH_API_BASE=https://my-endpoint.example.com/v1
# STEALTH_API_KEY=
# STEALTH_MODEL=my-model

# Optional: local Ollama, used last
# STEALTH_FALLBACK_BASE=http://localhost:11434/v1
# STEALTH_FALLBACK_MODEL=qwen2.5:7b

# Optional: OmniRoute gateway (local or Colab Cloudflare tunnel URL).
# Defaults to auto/best-free,auto/best-chat when OMNIROUTE_MODELS is omitted.
OMNIROUTE_API_KEY=
# OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
# OMNIROUTE_MODELS=auto/best-free,auto/best-chat,groq/openai/gpt-oss-120b,gemini/gemini-3.5-flash,openrouter/auto

# Optional: FreeLLMAPI gateway (its own upstream keys/routes must be configured).
FREELLMAPI_API_KEY=
# FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
# FREELLMAPI_MODELS=auto:reliable

# Optional: documented anonymous OVHcloud free tier (sends text to OVHcloud).
# Two requests/minute per model; the app paces calls and handles 429 responses.
HUMANIZER_ENABLE_OVH_ANONYMOUS=0
# OVH_MODELS=Meta-Llama-3_3-70B-Instruct,Mistral-Small-3.2-24B-Instruct-2506

# Optional: custom location for the downloaded trained detection model.
# HUMANIZER_DETECTOR_DIR=/absolute/path/to/desklib-v1.01
