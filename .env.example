# Copy this file to .env (or .keys.env) and fill in any keys you have.
# Every key is optional: with none, Humanizer Pro uses its offline rule engine.
# One key is enough; add more and the pool fails over between them automatically.

GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
SAMBANOVA_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
DEEPINFRA_API_KEY=
OPENAI_API_KEY=
# GitHub Models: a fine-grained token with "models: read"
GITHUB_MODELS_TOKEN=

# Optional: override the models tried for a provider (comma separated)
# GROQ_MODELS=llama-3.3-70b-versatile

# Optional: any OpenAI-compatible endpoint, tried first
# STEALTH_API_BASE=https://my-endpoint.example.com/v1
# STEALTH_API_KEY=
# STEALTH_MODEL=my-model

# Optional: local Ollama, used last
# STEALTH_FALLBACK_BASE=http://localhost:11434/v1
# STEALTH_FALLBACK_MODEL=qwen2.5:7b
